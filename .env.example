# Copy to .env and fill in. Every variable the app reads is listed here; values are placeholders.
# Nothing here is required to run the offline test suite except DATABASE_URL.

# ---------- Database (required: tests, migrations, server) ----------
DATABASE_URL=postgres://recepia:recepia@localhost:5434/recepia

# ---------- HTTP webhook (required by `pnpm start`) ----------
PORT=3000
# Shared secret for the Evolution webhook: must appear in the URL path AND the Authorization header.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---------- Reception / hand-off ----------
# Where escalations are delivered (E.164). Use a DIFFERENT number from any test patient.
RECEPTION_PHONE=+5511999999999
# Optional safety valve: a handed-off conversation resumes autonomously after N hours if reception
# never released it (`pnpm conversation:release <phone>`). Unset = never auto-release.
HANDOFF_AUTO_RELEASE_HOURS=

# ---------- LLM (Anthropic) ----------
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Optional; defaults to the production model pinned in src/adapters/llm/anthropic-llm.ts
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Google Calendar (service account; the calendar is shared with its email) ----------
# Path to the service-account key file (kept out of git under ./secrets/)
GOOGLE_CALENDAR_CREDENTIALS=./secrets/sa.json
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# ---------- WhatsApp outbound provider: "evolution" (dev, Baileys) or "cloud" (Meta Cloud API) ----------
MESSAGING_PROVIDER=evolution

# Evolution API (local docker stack in ./evolution)
EVOLUTION_BASE_URL=http://127.0.0.1:8081
EVOLUTION_API_KEY=REPLACE_ME
EVOLUTION_INSTANCE=recepia

# Meta WhatsApp Cloud API (production). The Cloud webhook is mounted only when VERIFY_TOKEN and
# APP_SECRET are both set.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---------- Observability and cost (feature 005) ----------
# Traces go to any OTLP/HTTP collector; unset = tracing off (no-op). Local viewer:
# `docker compose --profile observability up -d` then OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=recepia
# JSON logs (pino): trace, debug, info, warn, error, silent
LOG_LEVEL=info
# Secret for the patient pseudonym in logs/traces (HMAC of the phone). Unset = random per process.
TELEMETRY_HASH_KEY=
# Per-conversation estimated-cost budget (USD); reaching it hands the patient to reception.
AGENT_BUDGET_USD=0.25
# Per-call timeout for the Anthropic API (ms), so a hung call can fall back
ANTHROPIC_TIMEOUT_MS=30000
# Optional fallback provider (any OpenAI-compatible chat-completions endpoint); all three to enable.
# The model needs a price in src/llm/pricing.json or the service refuses to start.
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=
FALLBACK_LLM_TIMEOUT_MS=30000

# ---------- Evaluation harness (feature 004) ----------
# `pnpm evals:live` needs ANTHROPIC_API_KEY above. Per-run spend cap (USD) and executions per case;
# both can be overridden with --cap-usd / --repetitions. The harness TRUNCATES the database it points
# at: it refuses non-local hosts unless EVALS_ALLOW_TRUNCATE=1 (disposable databases only).
EVALS_CAP_USD=5
EVALS_REPETITIONS=3
# Judge model for `pnpm evals:judge` (must differ from the model under test; default claude-opus-5-5)
EVALS_JUDGE_MODEL=
EVALS_ALLOW_TRUNCATE=

# ---------- Live tests only (`pnpm test:live`; each suite runs when its flag is "1") ----------
LIVE_LLM=0
LIVE_CALENDAR=0
LIVE_CLOUD=0
LIVE_E2E=0
LIVE_E2E_PATIENT_PHONE=
